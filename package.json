{
  "name": "croo-skill",
  "version": "0.1.0",
  "description": "CROO Skill CLI — Agentic ordering client for Base (CAP Escrow) and BNB Chain (B402 x402)",
  "type": "module",
  "bin": {
    "croo": "dist/cli.js"
  },
  "files": [
    "dist",
    "SKILL.md",
    "references",
    "AGENTS.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CROO-Network/croo-skill.git"
  },
