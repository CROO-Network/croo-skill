    "url": "https://github.com/CROO-Network/croo-skill/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "croo",
    "agent",
    "x402",
    "b402",
    "cap",
    "base",
    "bsc",
    "skill"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
